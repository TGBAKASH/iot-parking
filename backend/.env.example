# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Replace with your PostgreSQL credentials or Render PostgreSQL connection string
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_parking_db
DB_USER=postgres
DB_PASSWORD=postgres
# Or provide a full URI (useful for Render PostgreSQL hosting):
# DATABASE_URL=postgres://user:password@hostname:5432/smart_parking_db

# Security Secret for JWT Authentication
JWT_SECRET=super_secret_jwt_key_change_me_in_production

# Frontend Origin for CORS
FRONTEND_URL=http://localhost:5173
